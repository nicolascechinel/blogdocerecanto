---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, dataBR } from '../../lib/url';
import { postsPublicados } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await postsPublicados();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base titulo={post.data.titulo} descricao={post.data.resumo}>
  <article class="secao">
    <div class="container estreito">
      <p class="pequeno"><a href={url('/acoes/')}>← Todas as ações</a></p>
      <h1>{post.data.titulo}</h1>
      <p class="meta">
        <time datetime={post.data.data.toISOString().slice(0, 10)}>{dataBR(post.data.data)}</time>
      </p>
      {post.data.capa && <img class="capa-post" src={url(post.data.capa)} alt={post.data.capaDescricao ?? ''} />}
      <div class="prosa">
        <Content />
      </div>
    </div>
  </article>
</Base>
