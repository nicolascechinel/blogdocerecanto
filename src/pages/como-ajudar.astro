---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import { url } from '../lib/url';
import { pixCopiaECola, pixQrSvg } from '../lib/pix';

const { pix } = site;
const temPix = Boolean(pix.chave?.trim());
const codigo = temPix ? pixCopiaECola(pix.chave, pix.tipoChave, pix.titular || site.nome, 'Sao Joaquim') : '';
const qr = temPix ? await pixQrSvg(codigo) : '';
---

<Base titulo="Como ajudar" descricao={`Doe por PIX, seja voluntário ou parceiro da ${site.nome}.`}>
  <section class="secao">
    <div class="container">
      <p class="olho">Como ajudar</p>
      <h1>Sua ajuda vira atendimento</h1>
      <p class="lead">
        As doações custeiam consultas, exames, terapias, cursos e atividades para crianças, adolescentes e jovens
        atendidos pela associação.
      </p>

      <h2 style="margin-top:2.5rem">Doe por PIX</h2>
      {temPix ? (
        <div class="pix">
          <div class="qr" set:html={qr} role="img" aria-label="QR Code do PIX da associação" />
          <div>
            <dl class="dados" style="margin-bottom:1rem">
              <dt>Chave{pix.tipoChave && ` (${pix.tipoChave})`}</dt><dd><strong>{pix.chave}</strong></dd>
              <dt>Titular</dt><dd>{pix.titular || site.nome}</dd>
              {pix.banco && (<><dt>Banco</dt><dd>{pix.banco}</dd></>)}
            </dl>
            <p class="pequeno suave">PIX copia e cola:</p>
            <code id="pix-codigo">{codigo}</code>
            <button class="btn" type="button" id="pix-copiar">Copiar código PIX</button>
            <p class="pequeno suave" style="margin-top:0.8rem">
              Confira o nome do titular no aplicativo do seu banco antes de confirmar.
            </p>
          </div>
        </div>
      ) : (
        <p class="vazio">
          A chave PIX da associação será publicada aqui em breve. Enquanto isso, fale com a gente pela página de
          <a href={url('/contato/')}>contato</a>.
        </p>
      )}

      <div class="grade" style="margin-top:2.5rem">
        <div class="cartao">
          <p class="numero">1</p>
          <h3>Seja voluntário</h3>
          <p>Ofereça seu tempo em oficinas, reforço escolar, atividades esportivas ou no dia a dia da associação.</p>
        </div>
        <div class="cartao">
          <p class="numero">2</p>
          <h3>Atenda como profissional</h3>
          <p>Psicólogos, médicos, dentistas, fisioterapeutas e fonoaudiólogos podem oferecer atendimentos.</p>
        </div>
        <div class="cartao">
          <p class="numero">3</p>
          <h3>Abra uma vaga</h3>
          <p>Empresas podem oferecer o primeiro emprego, estágio ou curso a jovens que saíram do acolhimento.</p>
        </div>
      </div>

      <p style="margin-top:2rem">
        Quer saber como o dinheiro é usado? Veja a página de <a href={url('/transparencia/')}>Transparência</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  const botao = document.getElementById('pix-copiar');
  const codigo = document.getElementById('pix-codigo');
  botao?.addEventListener('click', async () => {
    const texto = codigo?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(texto);
      botao.textContent = 'Código copiado';
    } catch {
      // Sem permissão de área de transferência: seleciona o texto para cópia manual.
      const sel = window.getSelection();
      const faixa = document.createRange();
      if (codigo && sel) {
        faixa.selectNodeContents(codigo);
        sel.removeAllRanges();
        sel.addRange(faixa);
      }
      botao.textContent = 'Selecione e copie o código';
    }
    setTimeout(() => (botao.textContent = 'Copiar código PIX'), 2500);
  });
</script>
